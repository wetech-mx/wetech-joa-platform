# Configuración no secreta del exportador automático.
# Las credenciales bancarias permanecen únicamente en backend/.env.
BAZ_EXPORT_TIME_ZONE=America/Mexico_City
BAZ_EXPORT_OUTBOX=/srv/banco-azteca-transfer/outbox

# Fechas opcionales que no deben considerarse hábiles.
# Formato: AAAA-MM-DD,AAAA-MM-DD
# Ejemplo: BAZ_HOLIDAYS=2026-09-16,2026-11-16
BAZ_HOLIDAYS=

# Empresa propietaria de la cartera importada.
BAZ_IMPORT_EMPRESA_ID=1
