app.post('/api/usuarios', async (req, res) => {

  const {
    nombre,
    email,
    password,
    rol
  } = req.body

  try {

    const hash = await bcrypt.hash(password, 10)

    await pool.query(`
      INSERT INTO usuarios
      (
        nombre,
        email,
        password_hash,
        rol
      )
      VALUES
      (
        $1,
        $2,
        $3,
        $4
      )
    `,
    [
      nombre,
      email,
      hash,
      rol
    ])

    res.json({
      success: true
    })

  } catch(error){

    console.error(error)

    res.status(500).json({
      error: 'Error creando usuario'
    })

  }

})

